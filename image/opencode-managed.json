{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*worktree prune*": "deny",
      "*worktree \"prune\"*": "deny",
      "*worktree 'prune'*": "deny",
      "*worktree remove*": "deny",
      "*worktree \"remove\"*": "deny",
      "*worktree 'remove'*": "deny",
      "*worktree move*": "deny",
      "*worktree \"move\"*": "deny",
      "*worktree 'move'*": "deny"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "node",
        "@MCP_CLI@",
        "--browser",
        "chromium",
        "--no-sandbox"
      ],
      "enabled": true
    }
  }
}
