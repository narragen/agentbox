# Pinned tool versions baked into the agentbox image. `agentbox build` passes every
# line here to `docker build` as a --build-arg, so this file is the single source of
# truth. `agentbox update` checks these against upstream; `agentbox update --apply`
# rewrites them. Format: KEY=VALUE, no quotes, no spaces.

# Agent CLIs
CLAUDE_CODE_VERSION=2.1.273
CODEX_VERSION=0.154.0
OPENCODE_VERSION=1.18.31

# Toolchains
NODE_VERSION=24
PYTHON_VERSION=3.14
UV_VERSION=0.12.15
PNPM_VERSION=12.4.2
BUN_VERSION=1.4.2

# Browser tooling. PLAYWRIGHT_VERSION selects the Microsoft image the stable browsers
# are copied from (avoids the Playwright CDN download hang). The MCP bundles its own
# (usually newer, alpha) playwright-core, whose chromium revision is installed on top.
PLAYWRIGHT_VERSION=1.63.0
PLAYWRIGHT_MCP_VERSION=0.0.81

# Shell and git tooling
GIT_DELTA_VERSION=0.19.2
PRE_COMMIT_VERSION=4.6.2
